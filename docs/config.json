      ]],
      ["Items & Inventory", [
          ["items/item", "Item"],
          ["items/itembuilder", "ItemBuilder"],
          ["items/inventory", "Inventory"],
          ["items/recipe", "Recipe"]
      ]],
      ["Effects & Attributes", [
          ["effects/effect", "Effect"],
