  "copyright_holder": "Omena0",
  "project_url": "https://github.com/Omena0/PyJavaBridge",
  "site_path_prefix": "/PyJavaBridge",
  "src_dir": "src",
  "out_dir": "site",
  "docs_dir": ".",
  "sidebar": [
